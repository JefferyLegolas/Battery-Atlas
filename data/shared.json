  "metricDefinitions": [
    {
      "id": "specificEnergy",
      "label": "重量能量密度",
      "definition": "Wh/kg；必须区分电芯、模组、系统与活性物质。"
    },
    {
      "id": "energyDensity",
      "label": "体积能量密度",
      "definition": "Wh/L；外壳、辅机和系统边界会影响结果。"
    },
    {
      "id": "capacity",
      "label": "容量 / 比容量",
      "definition": "Ah 是电池容量；mAh/g 是材料比容量，不能直接比较。"
    },
    {
      "id": "cycleLife",
      "label": "循环寿命 / 耐久",
      "definition": "同时查看容量保持率、放电深度 DOD、倍率和温度。实验运行小时数不等于循环次数。"
    },
    {
      "id": "calendarLife",
      "label": "日历寿命",
      "definition": "随时间老化的使用寿命；设计寿命、质保和实测寿命并不相同。"
    },
    {
      "id": "energyEfficiency",
      "label": "往返能量效率",
      "definition": "放电能量 ÷ 充电能量；DC–DC 与含逆变器的 AC–AC 不能混用。"
    },
    {
      "id": "coulombicEfficiency",
      "label": "库仑效率",
      "definition": "放电电量 ÷ 充电电量；不等同于往返能量效率。"
    },
    {
      "id": "temperature",
      "label": "温度条件",
      "definition": "区分充电、放电、储存与实验温度；不是安全极限。"
    },
    {
      "id": "charge",
      "label": "充电能力",
      "definition": "充电时间需配合起止 SOC、温度与充电策略；1C 不是保证一小时充满。"
    },
    {
      "id": "discharge",
      "label": "放电 / 输出能力",
      "definition": "连续输出、脉冲功率与实验电流密度不能混用。"
    },
    {
      "id": "storage",
      "label": "储存 / 自放电",
      "definition": "货架寿命不是每月自放电率；启封与储存温度很重要。"
    },
    {
      "id": "cost",
      "label": "成本口径",
      "definition": "电芯采购价、系统安装成本和全寿命度电成本 LCOS 不同。历史数据不是当前报价。"
    }
  ],
